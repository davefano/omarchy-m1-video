#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# apple-avd-rebuild: keep the patched apple_avd (Apple Video Decoder) kernel module
# in sync with the installed linux-asahi kernels.
#
# Part of omarchy-m1-video: https://github.com/iconidentify/omarchy-m1-video
#
# For each installed linux-asahi kernel this fetches that kernel's avd driver
# source from AsahiLinux/linux, applies the patches in
# /usr/local/share/apple-avd-patched/patches (skipping leading patches that
# upstream already contains), builds the module as an unprivileged throwaway
# user, and installs /usr/lib/modules/<kver>/updates/apple-avd.ko. If upstream
# contains every patch, the stock module is used.
#
# Usage: apple-avd-rebuild              rebuild where needed (pacman hook, boot service)
#        apple-avd-rebuild --force      rebuild every kernel even if up to date
#        apple-avd-rebuild --status     show what is installed and loaded
#        apple-avd-rebuild --check-libva
#                                       check the VA-API driver package
set -uo pipefail
export LC_ALL=C
shopt -s nullglob

SYSROOT=${OMARCHY_M1_VIDEO_SYSROOT:-}
TEST_MODE=${OMARCHY_M1_VIDEO_TEST_MODE:-0}
test_root_error() { echo "invalid test environment: $*" >&2; exit 1; }
[[ $TEST_MODE == 0 || $TEST_MODE == 1 ]] || test_root_error "unknown test mode"
if [[ $TEST_MODE == 1 ]]; then
	[[ -n $SYSROOT ]] || test_root_error "test mode requires a disposable sysroot"
	[[ $EUID -ne 0 ]] || test_root_error "test mode must run as an unprivileged user"
fi
[[ -z $SYSROOT || $TEST_MODE == 1 ]] || \
	test_root_error "OMARCHY_M1_VIDEO_SYSROOT is only available with OMARCHY_M1_VIDEO_TEST_MODE=1"
if [[ -n $SYSROOT ]]; then
	[[ $SYSROOT == /* ]] || test_root_error "OMARCHY_M1_VIDEO_SYSROOT must be an absolute path"
	[[ $SYSROOT != / ]] || test_root_error "refusing to use / as a test sysroot"
	physical_root=$(cd -- "$SYSROOT" 2>/dev/null && pwd -P) || test_root_error "sysroot does not exist"
	[[ $SYSROOT == "$physical_root" ]] || test_root_error "sysroot must be a canonical physical directory"
	[[ -f $SYSROOT/.omarchy-m1-video-test-root && ! -L $SYSROOT/.omarchy-m1-video-test-root ]] || \
		test_root_error "test sysroot is missing .omarchy-m1-video-test-root"
fi
sys() { printf '%s%s' "$SYSROOT" "$1"; }

SHARE=$(sys /usr/local/share/apple-avd-patched)
PATCHES=("$SHARE"/patches/[0-9][0-9][0-9][0-9]-*.patch)
REPO=https://github.com/AsahiLinux/linux.git
AVD_REL=drivers/media/platform/apple/avd
STAMP=apple-avd.ko.patched-stamp
LIBVA_SO=$(sys /usr/lib/dri/v4l2_request_drv_video.so)
LIBVA_MARKER='v4l2-request (omarchy-m1-video 1.3.r11)'
STOCK_BUG='the stock driver stops every H.264 stream after 4096 slices (seconds to minutes of video)'

say()  { echo "==> apple-avd: $*"; }
warn() { echo "==> apple-avd: WARNING: $*" >&2; }

# Kernels installed by the linux-asahi package: prints "<kver> <pkgver>".
asahi_kernels() {
	local d k pkg ver
	for d in "$(sys /usr/lib/modules)"/*/; do
		k=$(basename "$d")
		[[ -e $d/vmlinuz ]] || continue
		pkg=$(pacman -Qqo "$d/vmlinuz" 2>/dev/null) || continue
		[[ $pkg == linux-asahi ]] || continue
		ver=$(pacman -Q linux-asahi 2>/dev/null | awk '{print $2}')
		[[ -n $ver ]] && echo "$k $ver"
	done
}

# linux-asahi [epoch:]pkgver-pkgrel -> AsahiLinux/linux tag, following the PKGBUILD:
#   pkgver=${_rcver}${_rcrel:+rc}${_rcrel}.asahi${_asahirel}
#   tag   =asahi-${_rcver}${_rcrel+-rc}${_rcrel}-${_asahirel}
tag_for_pkgver() {
	local v=${1#*:} base rel
	v=${v%-*}
	base=${v%.asahi*}
	rel=${v##*.asahi}
	if [[ $base =~ ^(.+)rc([0-9]+)$ ]]; then
		echo "asahi-${BASH_REMATCH[1]}-rc${BASH_REMATCH[2]}-$rel"
	else
		echo "asahi-$base-$rel"
	fi
}

patchset_id() { cat "${PATCHES[@]}" | sha256sum | cut -c1-12; }

check_libva() {
	local ver libva_ver libva_minor symbols have have_minor symbol compatible=0 failed=0
	ver=$(pacman -Q libva-v4l2_request-avd 2>/dev/null || echo "libva-v4l2_request-avd (not installed)")
	if [[ ! -f $LIBVA_SO ]]; then
		warn "$LIBVA_SO missing ($ver); there is no hardware video decoding."
		warn "  Run install.sh from omarchy-m1-video again after reviewing its installation/boot-risk instructions."
		return 1
	fi
	if grep -aFq "$LIBVA_MARKER" "$LIBVA_SO"; then
		say "VA-API driver: $ver"
	else
		warn "$ver does not contain the expected omarchy-m1-video 1.3.r11 build marker."
		warn "  It may lack playback and memory-safety fixes. Run install.sh from omarchy-m1-video again after reviewing its installation/boot-risk instructions."
		failed=1
	fi
	# Read the dynamic symbol table without loading the driver. Embedded names,
	# undefined imports and hidden symbols cannot satisfy libva's dlsym lookup.
	if ! symbols=$(readelf --dyn-syms --wide "$LIBVA_SO" 2>/dev/null); then
		warn "cannot inspect VA-API dynamic symbols in $LIBVA_SO; check the driver file and install binutils (readelf)."
		return 1
	fi
	have=$(awk '$4 == "FUNC" && ($5 == "GLOBAL" || $5 == "WEAK") &&
		($6 == "DEFAULT" || $6 == "PROTECTED") && $7 != "UND" &&
		$8 ~ /^__vaDriverInit_1_(0|[1-9][0-9]*)(@@[^@]+)?$/ {
			sub(/@@.*/, "", $8); print $8
		}' <<<"$symbols")
	if [[ -z $have ]]; then
		warn "$LIBVA_SO exports no supported VA-API entry point; run install.sh from omarchy-m1-video again after reviewing its installation/boot-risk instructions."
		return 1
	fi
	# libva 2.x uses driver ABI 1.x and searches its own minor then older
	# versions. Other package major versions are unknown, not assumed compatible.
	libva_ver=$(pacman -Q libva 2>/dev/null | awk '{print $2}')
	if [[ ! ${libva_ver#*:} =~ ^2\.([0-9]+)\.[0-9]+(-[0-9]+(\.[0-9]+)*)?$ ]]; then
		warn "cannot determine a supported installed libva ABI from '$libva_ver'; check the libva package before rebuilding the driver."
		return 1
	fi
	libva_minor=${BASH_REMATCH[1]}
	while IFS= read -r symbol; do
		have_minor=${symbol##*_}
		# Decimal strings come from ELF data; compare with awk to avoid shell
		# arithmetic overflow or octal interpretation of unusual symbol names.
		if awk -v have="$have_minor" -v installed="$libva_minor" 'BEGIN { exit !(have <= installed) }'; then
			compatible=1
		fi
	done <<<"$have"
	if [[ $compatible == 0 ]]; then
		warn "the VA-API driver was built for a newer libva than $libva_ver; update libva and the driver together or rebuild the driver against the installed libva."
		failed=1
	fi
	return "$failed"
}

status() {
	local k pv tag stamp
	say "running kernel $(uname -r); apple_avd taint=$(cat "$(sys /sys/module/apple_avd/taint)" 2>/dev/null || echo not-loaded)"
	say "module selected for the next load: $(modinfo -n apple_avd 2>/dev/null || echo missing)"
	# modinfo resolves the module on disk; it cannot identify which binary
	# an already-loaded module came from after a rebuild.
	if [[ -d $(sys /sys/module/apple_avd) ]]; then
		say "loaded module binary identity: unknown (the selected on-disk file does not identify an already-loaded binary)"
	else
		say "loaded module binary identity: not loaded"
	fi
	while read -r k pv; do
		tag=$(tag_for_pkgver "$pv")
		stamp=$(cat "$(sys "/usr/lib/modules/$k/updates/$STAMP")" 2>/dev/null || echo "none (stock module)")
		say "$k  linux-asahi $pv  tag $tag  local build: $stamp"
	done < <(asahi_kernels)
	check_libva
}

cleanup_orphans() {
	local s d k
	for s in "$(sys /usr/lib/modules)"/*/updates/"$STAMP"; do
		d=${s%/updates/*}
		k=$(basename "$d")
		[[ $k == "$(uname -r)" ]] && continue          # still needed until reboot
		pacman -Qqo "$d/vmlinuz" >/dev/null 2>&1 && continue
		rm -f "$d/updates/apple-avd.ko" "$s"
		rmdir "$d/updates" 2>/dev/null
		say "removed local apple-avd.ko for uninstalled kernel $k"
	done
}

# An unused UID/GID for building, so no other process (not even 'nobody') can
# reach the build tree between patching and installing.
pick_build_id() {
	local id
	if [[ $TEST_MODE == 1 ]]; then
		echo 60500
		return 0
	fi
	for id in $(seq 60500 60599); do
		getent passwd "$id" >/dev/null && continue
		getent group "$id" >/dev/null && continue
		pgrep -u "$id" >/dev/null 2>&1 && continue
		echo "$id"
		return 0
	done
	return 1
}

PROXY_ENV=()
for v in http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY; do
	[[ -n ${!v:-} ]] && PROXY_ENV+=("$v=${!v}")
done

# Run as the build user, without the lock fd.
nob() {
	if [[ $TEST_MODE == 1 ]]; then
		if [[ ${#PROXY_ENV[@]} -gt 0 ]]; then
			env HOME="$B" PATH="$PATH" GIT_TERMINAL_PROMPT=0 "${PROXY_ENV[@]}" "$@" 9>&-
		else
			env HOME="$B" PATH="$PATH" GIT_TERMINAL_PROMPT=0 "$@" 9>&-
		fi
		return
	fi
	if [[ ${#PROXY_ENV[@]} -gt 0 ]]; then
		setpriv --reuid="$BUILD_ID" --regid="$BUILD_ID" --clear-groups \
			env -i HOME="$B" PATH=/usr/bin GIT_TERMINAL_PROMPT=0 "${PROXY_ENV[@]}" "$@" 9>&-
	else
		setpriv --reuid="$BUILD_ID" --regid="$BUILD_ID" --clear-groups \
			env -i HOME="$B" PATH=/usr/bin GIT_TERMINAL_PROMPT=0 "$@" 9>&-
	fi
}

# Patch the pristine tree $1 into $B/avd. Leading patches that upstream already
# contains are skipped: the largest k for which patches 1..k reverse-apply to the
# pristine tree and k+1..n apply on top wins. Sets SKIPPED.
prepare_tree() {
	local src=$1 n=${#PATCHES[@]} k i
	for ((k = n; k >= 0; k--)); do
		nob rm -rf "$B/try" && nob cp -r "$src" "$B/try" || return 2
		for ((i = k - 1; i >= 0; i--)); do
			nob patch -d "$B/try" -p6 -R -f -s --fuzz=0 --no-backup-if-mismatch -r - \
				<"${PATCHES[i]}" >/dev/null 2>&1 || continue 2
		done
		nob rm -rf "$B/avd" && nob cp -r "$src" "$B/avd" || return 2
		for ((i = k; i < n; i++)); do
			nob patch -d "$B/avd" -p6 -N -f -s --fuzz=0 --no-backup-if-mismatch -r - \
				<"${PATCHES[i]}" >/dev/null 2>&1 || continue 2
		done
		SKIPPED=$k
		return 0
	done
	return 1
}

# Sourcing exposes the helpers for offline regression tests; it never builds.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

[[ $# -le 1 ]] || { echo "usage: $0 [--force|--status|--check-libva]" >&2; exit 2; }
FORCE=0
case "${1:-}" in
	--status) status; exit $? ;;
	--check-libva) check_libva; exit $? ;;
	--force) FORCE=1 ;;
	"") ;;
	*) echo "usage: $0 [--force|--status|--check-libva]" >&2; exit 2 ;;
esac

if [[ $TEST_MODE != 1 ]]; then
	[[ $EUID -eq 0 ]] || { echo "must run as root" >&2; exit 1; }
fi
exec 9>"$(sys /run/apple-avd-rebuild.lock)"
flock -w 600 9 || { warn "another apple-avd-rebuild is running"; exit 1; }

if [[ ${#PATCHES[@]} -eq 0 ]]; then
	warn "no patches in $SHARE/patches; run install.sh from omarchy-m1-video again."
	exit 1
fi

cleanup_orphans

PID=$(patchset_id)
FAILED=0 UPSTREAM=0 KERNELS=0
while read -r K PV; do
	KERNELS=$((KERNELS + 1))
	TAG=$(tag_for_pkgver "$PV")
	DEST=$(sys "/usr/lib/modules/$K/updates")
	WANT="tag=$TAG patches=$PID"

	if [[ $FORCE -eq 0 && -f $DEST/apple-avd.ko && "$(cat "$DEST/$STAMP" 2>/dev/null)" == "$WANT" ]]; then
		say "$K: patched module up to date ($TAG)"
		continue
	fi
	if [[ -f $DEST/$STAMP ]]; then
		KEPT="the previously installed patched module ($(cat "$DEST/$STAMP")) stays in use"
	else
		KEPT="this kernel uses the stock driver; $STOCK_BUG"
	fi
	if [[ ! -f $(sys "/usr/lib/modules/$K/build/Makefile") ]]; then
		warn "$K: linux-asahi-headers for this kernel is not installed; cannot build."
		warn "  Until then $KEPT. Install matching headers and run: sudo apple-avd-rebuild"
		FAILED=1; continue
	fi
	if ! BUILD_ID=$(pick_build_id); then
		warn "$K: no free build UID in 60500-60599; not building."
		FAILED=1; continue
	fi

	R=$(mktemp -d /tmp/apple-avd-rebuild.XXXXXX) || { FAILED=1; continue; }
	chmod 0711 "$R"
	B=$R/build
	mkdir -m 0700 "$B" && { [[ $TEST_MODE == 1 ]] || chown "$BUILD_ID:$BUILD_ID" "$B"; } || { rm -rf "$R"; FAILED=1; continue; }

	say "$K: fetching $AVD_REL from AsahiLinux/linux $TAG"
	if ! nob timeout 300 git -c advice.detachedHead=false clone -q --depth 1 --filter=blob:none --sparse -b "$TAG" "$REPO" "$B/linux" 2>"$R/git.log" ||
	   ! nob timeout 300 git -C "$B/linux" sparse-checkout set "$AVD_REL" 2>>"$R/git.log" ||
	   ! nob test -f "$B/linux/$AVD_REL/avd-h264.c"; then
		warn "$K: could not fetch $TAG (offline, proxy, or tag missing). Until then $KEPT."
		warn "  Retry: sudo apple-avd-rebuild (also runs at boot while the module is missing)"
		tail -5 "$R/git.log" >&2
		rm -rf "$R"; FAILED=1; continue
	fi

	SKIPPED=0
	prepare_tree "$B/linux/$AVD_REL"
	case $? in
		0) ;;
		1)
			warn "$K: the patches do not apply to $TAG; they need updating in omarchy-m1-video."
			warn "  Until then $KEPT."
			rm -rf "$R"; FAILED=1; continue ;;
		*)
			warn "$K: could not prepare the source tree"
			rm -rf "$R"; FAILED=1; continue ;;
	esac

	if [[ $SKIPPED -eq ${#PATCHES[@]} ]]; then
		say "$K: UPSTREAM FIXED. $TAG already has every patch; the stock module will be used."
		if [[ -f $DEST/$STAMP ]]; then rm -f "$DEST/apple-avd.ko" "$DEST/$STAMP"; rmdir "$DEST" 2>/dev/null; depmod -a "$K"; fi
		UPSTREAM=$((UPSTREAM + 1)); rm -rf "$R"; continue
	fi
	[[ $SKIPPED -gt 0 ]] && say "$K: $TAG already has the first $SKIPPED patch(es); applying the rest"

	say "$K: building apple-avd.ko"
	if ! nob make -s -C "$(sys "/usr/lib/modules/$K/build")" M="$B/avd" CONFIG_VIDEO_APPLE_AVD=m modules -j"$(nproc)" >"$R/build.log" 2>&1; then
		warn "$K: build failed; until it builds $KEPT:"; tail -15 "$R/build.log" >&2
		rm -rf "$R"; FAILED=1; continue
	fi
	# Copy the result out of the build user's tree before root looks at it.
	if ! nob cat "$B/avd/apple-avd.ko" >"$R/apple-avd.ko"; then
		warn "$K: built module missing"
		rm -rf "$R"; FAILED=1; continue
	fi
	VM=$(modinfo -F vermagic "$R/apple-avd.ko")
	if [[ $VM != "$K "* ]]; then
		warn "$K: built module vermagic '$VM' does not match; not installing"
		rm -rf "$R"; FAILED=1; continue
	fi

	TMPKO=$DEST/.apple-avd.ko.$$
	if install -Dm644 "$R/apple-avd.ko" "$TMPKO" &&
	   strip --strip-debug "$TMPKO" &&
	   mv -f "$TMPKO" "$DEST/apple-avd.ko" &&
	   printf '%s\n' "$WANT" >"$DEST/$STAMP.$$" &&
	   mv -f "$DEST/$STAMP.$$" "$DEST/$STAMP" &&
	   depmod -a "$K"; then
		say "$K: installed patched apple-avd.ko ($TAG, patches $PID)"
		[[ $K == "$(uname -r)" ]] && say "  loads on next boot (or now, with no video playing: sudo modprobe -r apple_avd && sudo modprobe apple_avd)"
	else
		rm -f "$TMPKO" "$DEST/$STAMP.$$"
		warn "$K: installing the module failed"
		FAILED=1
	fi
	rm -rf "$R"
done < <(asahi_kernels)

if [[ $KERNELS -gt 0 && $UPSTREAM -eq $KERNELS ]]; then
	say "Every installed kernel has the fixes upstream. You can retire the kernel side:"
	say "  run uninstall.sh from omarchy-m1-video (see https://github.com/iconidentify/omarchy-m1-video)"
fi
exit $(( FAILED > 0 ? 1 : 0 ))
