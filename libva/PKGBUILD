# SPDX-License-Identifier: GPL-2.0-only
# VA-API driver for V4L2 stateless decoders, with Apple Video Decoder (AVD) fixes.
#
# Based on the libva-v4l2_request-avd package in omarchy-mac/omarchy-pkgs-aarch64.
#
# Builds https://github.com/iconidentify/libva-v4l2_request, pinned by commit:
# megi's libva-v4l2_request, sofus13's AVD support
# (tag 1.3), Igor Ryzhkov's and Ante042's early-export fix for Chrome's green
# frames, plus fixes for H.264 multi-slice hangs, HEVC slice header parsing,
# 10-bit HEVC, crafted headers, frame lifetime, error propagation and opt-in
# H.264 High 10, AVD short-term HEVC reference ordering, VP9 validation and state
# persistence, and strict conformance checks.
#
# AVD is a stateless decoder, which almost no desktop software speaks directly;
# this driver is what lets mpv, Chrome and FFmpeg use it through VA-API.

pkgname=libva-v4l2_request-avd
pkgver=1.3.r11
pkgrel=2
_commit=db3014f9499694c6f186af7e023de07bd5bc3564
pkgdesc='VA-API driver for V4L2 stateless decoders, with Apple Video Decoder (AVD) fixes (omarchy-m1-video)'
arch=('aarch64')
url='https://github.com/iconidentify/libva-v4l2_request'
license=('GPL-3.0-or-later')
# dlopen()ed plugin: links only libc and exports the versioned VA backend entry
# point. Older entrypoints work with newer libva minors; the package bounds
# and omarchy-m1-video pacman hook reject unsupported combinations.
depends=('glibc' 'libva>=2.24' 'libva<3')
makedepends=('git' 'meson' 'libdrm')
provides=('libva-v4l2_request')
conflicts=('libva-v4l2_request')
install="$pkgname.install"
source=("libva-v4l2_request::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  meson setup \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode=nodownload \
    libva-v4l2_request build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  # libva's package version is 2.x while its backend ABI is 1.x. Record
  # the build headers' minimum loader version, including on future rebuilds.
  local va_api
  va_api=$(pkg-config --modversion libva)
  [[ $va_api =~ ^1\.([0-9]+)\.[0-9]+$ ]] || return 1
  depends=('glibc' "libva>=2.${BASH_REMATCH[1]}" 'libva<3')

  meson install -C build --destdir "$pkgdir"

  # libva picks its driver from the DRM driver name of the render node, which on
  # Apple Silicon is "asahi", so it looks for asahi_drv_video.so. Aliasing it lets
  # every VA-API application find the decoder with no environment variable.
  ln -sf v4l2_request_drv_video.so "$pkgdir/usr/lib/dri/asahi_drv_video.so"

  install -Dm644 libva-v4l2_request/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 libva-v4l2_request/README "$pkgdir/usr/share/doc/$pkgname/README"
  install -Dm644 libva-v4l2_request/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 libva-v4l2_request/tests/README.md "$pkgdir/usr/share/doc/$pkgname/tests/README.md"
}
