post_install() {
  cat <<'MSG'
==> This package installs itself as asahi_drv_video.so as well, which is the
    name libva looks for on Apple Silicon, so VA-API applications should pick
    the decoder up with no configuration.

    If something does not, select it explicitly for the session:

        LIBVA_DRIVER_NAME=v4l2_request

==> Check with:  vainfo --display drm
==> mpv:         mpv --gpu-api=opengl --hwdec=vaapi video.mp4
==> Firefox hardware decoding has not been validated with this setup.
    See omarchy-m1-video's known issues before changing sandbox settings.
MSG
}

post_upgrade() {
  post_install
}
